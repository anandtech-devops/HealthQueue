# Copy to .env and replace EVERY placeholder. Never commit the real .env file.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# --- MySQL -------------------------------------------------------------------------------------
MYSQL_DATABASE=healthqueue
MYSQL_USER=healthqueue
MYSQL_PASSWORD=<choose-a-strong-password>
MYSQL_ROOT_PASSWORD=<choose-a-different-strong-password>

# --- Backend -----------------------------------------------------------------------------------
# Signing key for login tokens: at least 32 random characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRATION_MINUTES=480
# Comma-separated browser origins allowed to call the API directly (the bundled nginx proxy does not need CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Average consultation length used for the "estimated wait" (minutes).
AVG_CONSULTATION_MINUTES=5
# false = slots that have already passed today cannot be booked. Set true to try the demo late in the day.
BOOKING_ALLOW_PAST_SLOTS_TODAY=false
APP_TIMEZONE=Asia/Kolkata

# --- Demo data (LOCAL DEMO ONLY - keep false anywhere real) -------------------------------------
# true creates demo accounts @demo.example.com that all use DEMO_PASSWORD (8+ chars).
SEED_DEMO_DATA=true
DEMO_PASSWORD=<choose-a-demo-password>

# --- Ports -------------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
